# Home servers, configured from github.com/ThonyPrice/homelab.
# Reached over the personal tailnet, which is shared to the work login.
Host homelab-0 homelab-1
    HostName %h.tail8da91a.ts.net
    User thony

# The unprivileged agent user on the coding box, for herdr.
Host homelab-1-agent
    HostName homelab-1.tail8da91a.ts.net
    User agent

# Fallback over the home LAN when Tailscale is down (addresses reserved in
# the router).
Host homelab-0-lan
    HostName 192.168.8.215
    User thony

Host homelab-1-lan
    HostName 192.168.8.219
    User thony
