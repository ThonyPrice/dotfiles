#!/bin/bash
# Copy mono's per-user 1Password secrets cache to another machine, so worktrees
# there are set up without 1Password (mono RN-5083, scripts/op-cache.sh).
#
# Usage: regnora-push-dev-secrets [ssh-target]     (default: agent@homelab-1)
#
# First fills this laptop's cache with any reference in mono main's templates
# that it lacks (1Password asks here, if at all), then pushes the whole cache.
# To push freshly rotated secrets, run `./scripts/setup-env.sh --refresh` in a
# mono worktree first. MONO_DIR overrides where mono is cloned (~/git/mono).
#
# The remote cache is replaced as a whole, so references dropped here are
# dropped there too. References under BLANKED arrive as empty files: the cache
# treats an empty file as deliberately blanked, so the variable comes out empty
# and nothing asks 1Password for it.
set -euo pipefail

TARGET="${1:-agent@homelab-1}"
SRC="${REGNORA_DEV_CONFIG:-$HOME/.config/regnora-dev}/secrets"

# Paths under the cache, as <vault>[/<item>[/<field>]].
BLANKED=(
    # Production database connection string: never on an agent box.
    "Shared"
    # regnora-runner service account key. Blanked until it is confirmed that
    # the key cannot reach production; then delete this line.
    "app-development/google-sa-regnora-runner"
)

MONO="${MONO_DIR:-$HOME/git/mono}"

is_blanked() {
    local rel="$1" path
    for path in "${BLANKED[@]}"; do
        [[ "$rel" == "$path" || "$rel" == "$path"/* ]] && return 0
    done
    return 1
}

umask 077

# Fill the local cache with every reference in mono main's templates, so the
# remote gets one even if no worktree here has needed it yet. A miss asks
# 1Password here, once; blanked references are not read at all.
refs=()
if [[ -d "$MONO/.git" ]]; then
    git -C "$MONO" fetch -q origin main
    mapfile -t refs < <(git -C "$MONO" grep -hoE 'op://[A-Za-z0-9._/-]+' origin/main \
        -- .env.template '*secrets.toml.example' | sort -u)
    # shellcheck source=/dev/null
    source <(git -C "$MONO" show origin/main:scripts/op-cache.sh)
    if ! declare -F op_cache_read >/dev/null; then
        echo "Error: could not load scripts/op-cache.sh from mono's origin/main." >&2
        exit 1
    fi
    for ref in "${refs[@]}"; do
        is_blanked "${ref#op://}" && continue
        op_cache_read "$ref" >/dev/null || {
            echo "Error: could not fill $ref into the local cache." >&2
            exit 1
        }
    done
else
    echo "Warning: no mono clone at $MONO; pushing the cache as it is." >&2
fi

if [[ ! -d "$SRC" ]] || [[ -z "$(find "$SRC" -type f -print -quit)" ]]; then
    echo "Error: no secrets cache at $SRC." >&2
    echo "Fill it by setting up a mono worktree, or run ./scripts/setup-env.sh in one." >&2
    exit 1
fi

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

cp -a "$SRC/." "$STAGE/"

# Blanked references must still exist remotely, as empty files.
for ref in "${refs[@]}"; do
    rel="${ref#op://}"
    is_blanked "$rel" || continue
    mkdir -p "$STAGE/$(dirname "$rel")"
    : >"$STAGE/$rel"
done

blanked=0
for path in "${BLANKED[@]}"; do
    [[ -e "$STAGE/$path" ]] || continue
    while IFS= read -r -d '' file; do
        : >"$file"
        blanked=$((blanked + 1))
    done < <(find "$STAGE/$path" -type f -print0)
done

total="$(find "$STAGE" -type f | wc -l)"

# Unpack next to the live cache, then swap, so an interrupted push never
# leaves a half-written cache behind.
# shellcheck disable=SC2016  # expanded on the remote side
remote='set -e
umask 077
dir="$HOME/.config/regnora-dev"
mkdir -p "$dir"
rm -rf "$dir/secrets.new" "$dir/secrets.old"
mkdir "$dir/secrets.new"
tar -C "$dir/secrets.new" -xf -
if [ -d "$dir/secrets" ]; then mv "$dir/secrets" "$dir/secrets.old"; fi
mv "$dir/secrets.new" "$dir/secrets"
rm -rf "$dir/secrets.old"
chmod 700 "$dir/secrets"'

# shellcheck disable=SC2029  # $remote is sent whole; its own $vars expand remotely
tar -C "$STAGE" -cf - . | ssh "$TARGET" "$remote"

echo "Pushed $total secrets to $TARGET ($blanked blanked: ${BLANKED[*]})."
